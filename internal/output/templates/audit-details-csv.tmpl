{{- /*
CSV export of the audit details, one row per advisory. The whole layout lives
here (edit the columns freely, no recompilation needed).

The "csvcell" helper quotes a value per RFC 4180: wrap it in double quotes and
double any embedded quote, so commas, quotes and newlines in free-text fields
(titles, ignore reasons) can't break the columns. Numeric/boolean cells are
emitted bare.
*/ -}}
{{- define "csvcell" -}}"{{ . | toString | replace "\"" "\"\"" }}"{{- end -}}
ID,Title,Severity,CVSS,CVEs,CWEs,Packages,URL,Ignored,Ignore Reason
{{- range .Results}}
{{template "csvcell" .ID}},{{template "csvcell" .Title}},{{template "csvcell" (.Severity | upper)}},{{if gt .CVSSScore 0.0}}{{.CVSSScore}}{{end}},{{template "csvcell" (join "; " .CVEs)}},{{template "csvcell" (join "; " .CWEs)}},{{template "csvcell" (join "; " .Packages)}},{{template "csvcell" .URL}},{{.Ignored}},{{template "csvcell" .IgnoreReason}}
{{- end}}
